# Required: Supabase Postgres connection string (Project → Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Required: free key from https://finnhub.io
FINNHUB_API_KEY=

# Anthropic credentials: leave unset if you use `ant auth login` (SDK picks up the profile)
# ANTHROPIC_API_KEY=

# Optional: Telegram push notifications (create a bot via @BotFather, get your chat id via @userinfobot)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: email verification at signup. Without this, signup creates the
# account immediately as before — everything else works.
# Free key from https://resend.com (3k emails/month, no card).
# RESEND_API_KEY=
# Sender address. The default (onboarding@resend.dev) needs no DNS setup but
# only delivers to the email you signed up to Resend with — fine for a personal
# account. To reach any other address, verify a domain in Resend and set this to
# something on it, e.g. noreply@yourdomain.com
# EMAIL_FROM=

# Optional model overrides (defaults: claude-sonnet-5 deep / claude-haiku-4-5 fast)
# SHARPEDGE_MODEL_DEEP=
# SHARPEDGE_MODEL_FAST=

# Dashboard port
PORT=3000
